---
import BaseLayout from "../layouts/BaseLayout.astro";
import FlowField from "../components/FlowField.astro";
import Connections from "../components/Connections.astro";
import Cta from "../components/Cta.astro";
import Icon from "../components/Icon.astro";
import { meta, services } from "../data/site.js";
import { withBase } from "../utils/url.js";
---

<BaseLayout {...meta.services}>
  <section class="page-intro">
    <FlowField />
    <div class="container">
      <h1>
        What we can
        <br />
        <span>help you with.</span>
      </h1>
      <p class="lede">
        A website that isn’t pulling its weight, a process that’s outgrown
        spreadsheets, tools that don’t talk to each other. Here’s how we help.
      </p>
      <nav class="capability-nav" aria-label="Our services">
        {services.map((service) => (
          <a href={`#${service.id}`}>{service.discipline}</a>
        ))}
      </nav>
    </div>
  </section>
  <div class="container">
    {services.map((service) => (
      <section class="service-detail" id={service.id}>
        <header>
          <h2>{service.name}</h2>
          <p class="service-detail__discipline">{service.discipline}</p>
        </header>
        <div>
          <div class="prose">
            {service.body.split("\n\n").map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <ul>
            {service.includes.map((item) => (
              <li>
                <Icon name="check" />
                {item}
              </li>
            ))}
          </ul>
          <a class="text-link" href={withBase("/contact/")}>
            Talk to us about this
            <Icon />
          </a>
        </div>
      </section>
    ))}
  </div>
  <section class="section">
    <div class="container">
      <header class="section-head">
        <h2>
          Often it’s more
          <br />
          than one thing.
        </h2>
        <p>
          A website problem can turn out to be a workflow problem, and a
          workflow problem can turn out to be two tools that don’t talk to each
          other. We look at the whole picture before suggesting a fix.
        </p>
      </header>
      <Connections />
    </div>
  </section>
  <Cta
    heading="Not sure which of these you need?"
    body="That’s completely normal. Tell us what’s going on, and we’ll help you figure out where to start."
  />
</BaseLayout>
