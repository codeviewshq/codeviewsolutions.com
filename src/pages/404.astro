---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../utils/url.js";
---

<BaseLayout
  title="Page not found — CodeView Solutions"
  description="This page could not be found. Return to CodeView Solutions or search for what you need."
>
  <section class="container empty-page">
    <h1>
      This page
      <br />
      isn’t here.
    </h1>
    <p>
      It may have moved, or the address might be slightly off.
    </p>
    <div class="actions">
      <a class="button" href={withBase("/")}>
        Back to home
        <Icon />
      </a>
      <button class="text-button" type="button" data-cmdk-open>
        <Icon name="search" />
        Search the site
      </button>
    </div>
    <p>404 · Page not found</p>
  </section>
</BaseLayout>
