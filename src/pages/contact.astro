---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewDrawing from '../components/ReviewDrawing.astro';
import ReviewForm from '../components/ReviewForm.astro';
import { meta, contact, site, plans } from '../data/site.js';
import { isPlaceholder } from '../utils/placeholder.js';

const emailReady = Boolean(site.email) && !isPlaceholder(site.email);
const phoneReady = Boolean(site.phone) && !isPlaceholder(site.phone);
const telHref = phoneReady ? `tel:${site.phone.replace(/[^+\d]/g, '')}` : undefined;


---

<BaseLayout title={meta.contact.title} description={meta.contact.description}>
  <section class="sh" id="enquiry" data-sheet="01" data-mark>
    <!-- A revision mark follows the highlighted heading. -->
        <svg class="markup" data-markup aria-hidden="true">
          <path class="mk-cloud" data-draw></path>
        </svg>

    <header class="sh__head">
      <h1 class="sh__h1">{contact.headingLead} <em data-cloud>{contact.headingAccent}</em></h1>
      <p class="sh__no">Enquiry sheet · {contact.label}</p>
    </header>
    <p class="note" data-note data-tag="REV A · COMMITTED">
      We reply within one business day. The review itself carries no obligation.
    </p>

    <div class="drawing-overview">
      <p class="sh__lede">{contact.intro}</p>
      <ReviewDrawing variant="contact" />
    </div>

    <p class="plan-context" data-plan-context hidden></p>

    <div class="form-grid" style="margin-top:clamp(1.75rem,3vw,2.75rem)">
      <ReviewForm />

      <div class="plate">
        <p class="plate__head">{contact.directLabel}</p>

        {
          phoneReady && (
            <div class="plate__row">
              <span class="plate__key">Phone</span>
              <span class="plate__val">
                <a href={telHref}>{site.phone}</a>
              </span>
            </div>
          )
        }

        {
          emailReady && (
            <div class="plate__row">
              <span class="plate__key">Email</span>
              <span class="plate__val">
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </span>
            </div>
          )
        }

        <div class="plate__row">
          <span class="plate__key">First conversation</span>
          <span class="plate__val">We discuss your site, priorities, and what the free review should cover.</span>
        </div>
        <div class="plate__row">
          <span class="plate__key">Before work starts</span>
          <span class="plate__val">You approve the design scope, revisions, plan allowance, extra costs, and cancellation terms.</span>
        </div>
        <div class="plate__row">
          <span class="plate__key">Service area</span>
          <span class="plate__val">{site.serviceArea}</span>
        </div>

        <div class="plate__row">
          <span class="plate__key">Response time</span>
          <span class="plate__val">Initial reply within one business day; completion times depend on the agreed work.</span>
        </div>

        <div class="plate__row">
          <span class="plate__key">Plans start at</span>
          <span class="plate__val">
            {plans.tiers[0].monthly.amount} a month, after a free design
          </span>
        </div>
      </div>
    </div>
  </section>
  <script>
    import { plans } from '../data/site.js';
    const query = new URLSearchParams(location.search);
    const tier = plans.tiers.find(t => t.id === query.get('plan'));
    const cycle = query.get('cycle') === 'annual' ? 'annual' : 'monthly';
    if (tier) {
      const context = document.querySelector<HTMLElement>('[data-plan-context]');
      if (context) {
        context.textContent = `Interested in ${tier.name}: ${tier[cycle].amount} ${tier[cycle].period}. Mention this plan when you contact us; scope and terms are agreed before work starts.`;
        context.hidden = false;
      }
      const planInput = document.querySelector<HTMLInputElement>('[data-enquiry-plan]');
      const cycleInput = document.querySelector<HTMLInputElement>('[data-enquiry-cycle]');
      if (planInput) planInput.value = tier.name;
      if (cycleInput) cycleInput.value = cycle;
    }
  </script>
</BaseLayout>
