---
import BaseLayout from "../layouts/BaseLayout.astro";
import FlowField from "../components/FlowField.astro";
import Journey from "../components/Journey.astro";
import ContactForm from "../components/ContactForm.astro";
import { meta, site } from "../data/site.js";
import { isPlaceholder } from "../utils/placeholder.js";
const emailReady = !isPlaceholder(site.email);
const phoneReady = !isPlaceholder(site.phone);
---

<BaseLayout {...meta.contact}>
  <section class="page-intro page-intro--short">
    <FlowField />
    <div class="container">
      <h1>
        Let’s talk it
        <br />
        <span>through.</span>
      </h1>
      <p class="lede">
        Whether it’s a website, a process, or just an idea, we’re happy to
        listen.
      </p>
    </div>
  </section>
  <section
    class="container contact-layout"
    aria-label="Contact and consultation"
  >
    <div class="contact-panel">
      <h2>
        Start with a
        <br />
        conversation.
      </h2>
      <p>
        The first consultation is free, with no obligation. Share a little about
        your business and what you’d like to change.
      </p>
      <ContactForm />
      <dl class="contact-methods">
        {emailReady && (
          <div>
            <dt>Email</dt>
            <dd>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
        )}
        {phoneReady && (
          <div>
            <dt>Phone</dt>
            <dd>
              <a href={`tel:${site.phone.replace(/[^+\d]/g, "")}`}>
                {site.phone}
              </a>
            </dd>
          </div>
        )}
        <div>
          <dt>Where we work</dt>
          <dd>Remotely, across the United States</dd>
        </div>
        <div>
          <dt>When you’ll hear from us</dt>
          <dd>An initial reply within one business day.</dd>
        </div>
      </dl>
    </div>
    <div class="contact-aside">
      <ol class="contact-steps">
        <li>
          <h3>Start with what’s on your mind.</h3>
          <p>
            What’s frustrating, what isn’t working, or what you’d like to build.
            Rough notes are fine.
          </p>
        </li>
        <li>
          <h3>We’ll talk through the options.</h3>
          <p>
            We’ll ask questions and help you see what makes sense. There’s no
            obligation to go further.
          </p>
        </li>
        <li>
          <h3>We agree a clear plan.</h3>
          <p>
            If it’s a good fit, we’ll set out the scope, fees, and next steps
            together before any work begins.
          </p>
        </li>
      </ol>
      <Journey />
    </div>
  </section>
</BaseLayout>
