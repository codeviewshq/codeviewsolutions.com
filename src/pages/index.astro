---
import BaseLayout from "../layouts/BaseLayout.astro";
import FlowField from "../components/FlowField.astro";
import Journey from "../components/Journey.astro";
import Connections from "../components/Connections.astro";
import WorkPlaceholder from "../components/WorkPlaceholder.astro";
import Cta from "../components/Cta.astro";
import Icon from "../components/Icon.astro";
import { hero, services, process, questions, meta } from "../data/site.js";
import { withBase } from "../utils/url.js";
---

<BaseLayout {...meta.home}>
  <section class="hero">
    <FlowField />
    <div class="container hero__content">
      <div class="hero__copy">
        <h1>
          {hero.headline}
          <br />
          <span>{hero.accent}</span>
        </h1>
        <p>{hero.body}</p>
        <div class="actions">
          <a class="button" href={withBase(hero.primaryCta.href)}>
            {hero.primaryCta.label}
            <Icon />
          </a>
          <a class="text-link" href="#approach">
            {hero.secondaryCta.label}
            <Icon name="diagonal" />
          </a>
        </div>
        <div class="hero__detail">The first conversation is free, with no obligation.</div>
      </div>
      <div class="hero__journey">
        <Journey />
      </div>
    </div>
    <div class="container hero__bottom">
      <p class="hero__disciplines">
        Working with businesses
        <br />
        across the United States.
      </p>
      <button
        class="text-button motion-toggle"
        type="button"
        data-motion-toggle
        aria-pressed="false"
      >
        <Icon name="pause" class="motion-pause" />
        <Icon name="play" class="motion-play" />
        <span data-motion-label>Pause motion</span>
      </button>
    </div>
  </section>
  <section class="section intro-section">
    <div class="container intro-grid">
      <h2 data-reveal>You don’t need a technical plan to get started.</h2>
      <div class="prose">
        <p>
          Maybe your website looks dated and isn’t bringing in enquiries. Maybe
          your team copies the same details between three tools every day. Or
          maybe you have an idea your customers would love, but you’re not sure
          where to begin.
        </p>
        <p>
          Whatever it is, we’ll listen, ask good questions, and help you work
          out a sensible fix. If it makes sense to build it together, we’ll take
          it from the first sketch to something that works.
        </p>
        <a class="text-link" href={withBase("/about/")}>
          More about us
          <Icon />
        </a>
      </div>
    </div>
  </section>
  <section class="section section--soft" id="capabilities">
    <div class="container">
      <header class="section-head">
        <h2 data-reveal>
          Where we
          <br />
          can help.
        </h2>
        <p>
          Most projects start in one of these four places, and plenty touch
          more than one.
        </p>
      </header>
      <div class="service-list">
        {services.map((service) => (
          <a class="service-row" href={withBase(`/services/#${service.id}`)}>
            <div>
              <h3>{service.name}</h3>
              <p class="service-row__discipline">{service.discipline}</p>
            </div>
            <p class="service-row__body">{service.summary}</p>
            <Icon name="diagonal" />
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <header class="section-head">
        <h2>
          Problems rarely live
          <br />
          in one place.
        </h2>
        <p>
          What your customers see, the work your team does behind it, and the
          tools holding it together are all connected. We look at all three.
        </p>
      </header>
      <Connections />
    </div>
  </section>
  <section class="section section--soft" id="work">
    <div class="container">
      <header class="section-head">
        <h2 data-reveal>
          Examples of our work
          <br />
          are on the way.
        </h2>
        <div>
          <p>
            Much of our past work is covered by confidentiality agreements, so
            we’re preparing examples we can share openly. Until then, we’re
            happy to talk through how we’d approach your project.
          </p>
          <a
            class="text-link"
            href={withBase("/work/")}
            style="margin-top:1rem"
          >
            See what’s coming
            <Icon />
          </a>
        </div>
      </header>
      <div class="work-grid">
        <WorkPlaceholder title="Selected projects" />
        <WorkPlaceholder demo />
      </div>
    </div>
  </section>
  <section class="section" id="approach">
    <div class="container approach">
      <div class="approach__intro">
        <h2>
          Working with us
          <br />
          should feel easy.
        </h2>
        <p>
          Technology can be complicated. We make sure the process of working
          together isn’t.
        </p>
      </div>
      <ol class="process-list">
        {process.map((step) => (
          <li>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section section--soft">
    <div class="container faq">
      <h2>
        Questions people
        <br />
        often ask us.
      </h2>
      <div>
        {questions.map((item) => (
          <details>
            <summary>
              {item.q}
              <Icon name="plus" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <Cta />
</BaseLayout>
