---
import BaseLayout from "../layouts/BaseLayout.astro";
import FlowField from "../components/FlowField.astro";
import Journey from "../components/Journey.astro";
import Cta from "../components/Cta.astro";
import { meta, process, site } from "../data/site.js";
---

<BaseLayout {...meta.about}>
  <section class="page-intro">
    <FlowField />
    <div class="container">
      <h1>
        Technology should
        <br />
        <span>make work easier.</span>
      </h1>
      <p class="lede">
        We help small and midsize businesses plan, design, and build websites,
        software, and integrations that fit the way they actually work.
      </p>
    </div>
  </section>
  <section class="section section--soft">
    <div class="container">
      <h2 class="about-statement" data-reveal>
        Too much software is built around what’s easy to sell rather than what’s
        useful. We try to do the opposite: understand how you work first, then
        build something that fits.
      </h2>
      <div class="principles">
        <div>
          <h3>We explain things plainly.</h3>
          <p>
            We ask questions, lay out your options, and are honest about the
            tradeoffs. You shouldn’t need a technical background to make a good
            decision.
          </p>
        </div>
        <div>
          <h3>We think about the whole job.</h3>
          <p>
            How something looks, how it works, and how it connects to your other
            tools all matter. We handle them together rather than in separate
            pieces.
          </p>
        </div>
        <div>
          <h3>We fit the work to you.</h3>
          <p>
            Your goals, your way of working, and the tools you already use shape
            what we recommend. We don’t push one product or approach on everyone.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container approach">
      <div class="approach__intro">
        <h2>
          How a project
          <br />
          usually goes.
        </h2>
        <p>
          No surprises. You’ll know what’s happening, why, and what it costs.
        </p>
        <Journey />
      </div>
      <ol class="process-list">
        {process.map((step) => (
          <li>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section section--soft">
    <div class="container intro-grid">
      <h2>
        It’s your work.
        <br />
        You keep control.
      </h2>
      <div class="prose">
        <p>
          Your custom code, content, and documentation belong to you, and your
          website and accounts stay under your control. If a project relies on
          third-party tools, we’ll tell you which ones and what their terms are
          up front.
        </p>
        <p>
          Fees, responsibilities, timing, and any ongoing support are agreed with
          you before work begins. The first consultation is free.
        </p>
        <dl class="company-record">
          <div>
            <dt>Company</dt>
            <dd>{site.legalName}</dd>
          </div>
          <div>
            <dt>Where we work</dt>
            <dd>Remotely, across the United States</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
  <Cta />
</BaseLayout>
