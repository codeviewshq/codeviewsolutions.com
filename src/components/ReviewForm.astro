---
import { contact, site } from '../data/site.js';
import { formAction } from '../utils/review-form.js';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const prefix = compact ? 'hero-review' : 'contact-review';
const FormTag = formAction ? 'form' : 'div';
---
<FormTag class:list={["form", { "form--compact": compact }]} method={formAction ? "POST" : undefined} action={formAction} data-form-live={formAction ? "true" : undefined} data-form-preview={!formAction ? "true" : undefined} aria-labelledby={compact ? "hero-review-heading" : undefined}>
  {compact && <div class="form__intro"><p class="form__eyebrow">Your next step</p><h2 id="hero-review-heading">Request a free website review</h2><p>Share your site. We’ll help you see what to improve.</p></div>}
  <div class="field">
    <label for={`${prefix}-name`}>Name <span class="req">*</span></label>
    <input id={`${prefix}-name`} name="name" type="text" autocomplete="name" required />
  </div>

  <div class="field">
    <label for={`${prefix}-email`}>Email <span class="req">*</span></label>
    <input id={`${prefix}-email`} name="email" type="email" autocomplete="email" required />
  </div>

  <div class="field">
    <label for={`${prefix}-website`}>Website address</label>
    <input id={`${prefix}-website`} name="website" type="url" inputmode="url" placeholder="https://example.com" />
  </div>

  {!compact && (<>
  <div class="field">
    <label for={`${prefix}-company`}>Company</label>
    <input id={`${prefix}-company`} name="company" type="text" autocomplete="organization" />
  </div>

  <div class="field">
    <label for={`${prefix}-project`}>What do you need?</label>
    <select id={`${prefix}-project`} name="project">
      {contact.projectTypes.map((type) => <option value={type}>{type}</option>)}
    </select>
  </div>

  <div class="field">
    <label for={`${prefix}-message`}>Message <span class="req">*</span></label>
    <textarea
      id={`${prefix}-message`}
      name="message"
      rows="7"
      required
      placeholder="Tell us what feels outdated, frustrating, or unreliable."></textarea>
  </div>

  </>)}

  <div class="gotcha" aria-hidden="true">
    <label for={`${prefix}-_gotcha`}>Leave this field empty</label>
    <input id={`${prefix}-_gotcha`} type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="plan" data-enquiry-plan />
  <input type="hidden" name="billing_period" data-enquiry-cycle />
  <input type="hidden" name="_subject" value="New enquiry from codeviewsolutions.com" />

  <div class="form__submit">
    <p class="form__privacy">{formAction ? "We use your details to respond to your enquiry." : <>Online requests will be available soon. For now, <a href={`mailto:${site.email}`}>email us for a free review</a>.</>}</p>
    <button class="stamp" type="submit" disabled={!formAction}>
      Get a free website review
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
        <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="square"></path>
      </svg>
    </button>
  </div>
</FormTag>
