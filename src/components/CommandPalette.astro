---
/**
 * ⌘K command palette.
 *
 * A working one: it searches every page and service, runs real actions, and is
 * entirely keyboard driven. Built on <dialog> so focus trapping, the backdrop,
 * and Escape-to-close come from the platform instead of hand-written code.
 *
 * The command list is generated here from src/data/site.js and serialised into
 * a JSON script tag, so adding a page or service updates the palette with no
 * extra work.
 */
import { nav, services, site } from '../data/site.js';
import { isPlaceholder } from '../utils/placeholder.js';
import { withBase } from '../utils/url.js';

type Command = {
  id: string;
  label: string;
  group: string;
  icon: 'page' | 'service' | 'mail' | 'copy';
  href?: string;
  action?: 'copy';
  value?: string;
  hint?: string;
  keywords?: string;
};

const commands: Command[] = [
  ...nav.map((item) => ({
    id: `page-${item.href}`,
    label: item.label,
    group: 'Pages',
    icon: 'page' as const,
    href: withBase(item.href),
    keywords: item.label,
  })),
  ...services.map((service) => ({
    id: `service-${service.id}`,
    label: service.name,
    group: 'Services',
    icon: 'service' as const,
    href: withBase(`/services/#${service.id}`),
    keywords: `${service.name} ${service.summary}`,
  })),
];

// Only offer the email actions once a real address has been filled in.
if (!isPlaceholder(site.email)) {
  commands.push(
    {
      id: 'action-mail',
      label: 'Send an email',
      group: 'Actions',
      icon: 'mail',
      href: `mailto:${site.email}`,
      hint: site.email,
      keywords: `email mail contact ${site.email}`,
    },
    {
      id: 'action-copy',
      label: 'Copy email address',
      group: 'Actions',
      icon: 'copy',
      action: 'copy',
      value: site.email,
      keywords: `copy email clipboard ${site.email}`,
    }
  );
}

// Only offer the phone actions once a real number has been filled in.
if (!isPlaceholder(site.phone)) {
  const tel = site.phone.replace(/[^+\d]/g, '');
  commands.push(
    {
      id: 'action-call',
      label: 'Call us',
      group: 'Actions',
      icon: 'mail',
      href: `tel:${tel}`,
      hint: site.phone,
      keywords: `call phone telephone ring ${site.phone} ${tel}`,
    },
    {
      id: 'action-copy-phone',
      label: 'Copy phone number',
      group: 'Actions',
      icon: 'copy',
      action: 'copy',
      value: site.phone,
      keywords: `copy phone number clipboard ${site.phone}`,
    }
  );
}

commands.push({
  id: 'action-start',
  label: 'Get a free website review',
  group: 'Actions',
  icon: 'mail',
  href: withBase('/contact/'),
  keywords: 'free website review contact audit help enquiry inquiry',
});
---

<dialog class="cmdk" data-cmdk aria-label="Command palette">
  <div class="cmdk__search">
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>

    <input
      class="cmdk__input"
      data-cmdk-input
      type="text"
      role="combobox"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search pages, services, actions…"
      aria-expanded="true"
      aria-controls="cmdk-list"
      aria-autocomplete="list"
    />
  </div>

  <ul class="cmdk__list" id="cmdk-list" data-cmdk-list role="listbox" aria-label="Results"></ul>

  <p class="cmdk__empty" data-cmdk-empty hidden>No matches.</p>

  <div class="cmdk__foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
    <span data-cmdk-status role="status" aria-live="polite"></span>
  </div>
</dialog>

<script type="application/json" data-cmdk-data set:html={JSON.stringify(commands)} />

<script>
  type Command = {
    id: string;
    label: string;
    group: string;
    icon: string;
    href?: string;
    action?: string;
    value?: string;
    hint?: string;
    keywords?: string;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-cmdk]');
  const input = document.querySelector<HTMLInputElement>('[data-cmdk-input]');
  const list = document.querySelector<HTMLUListElement>('[data-cmdk-list]');
  const empty = document.querySelector<HTMLElement>('[data-cmdk-empty]');
  const status = document.querySelector<HTMLElement>('[data-cmdk-status]');
  const dataTag = document.querySelector<HTMLScriptElement>('[data-cmdk-data]');

  if (dialog && input && list && dataTag) {
    const commands: Command[] = JSON.parse(dataTag.textContent || '[]');

    const ICONS: Record<string, string> = {
      page: '<path d="M4 3h9l7 7v11H4z"/><path d="M13 3v7h7"/>',
      service: '<path d="M4 7h16M4 12h16M4 17h10"/>',
      mail: '<path d="M3 5h18v14H3z"/><path d="m3 6 9 7 9-7"/>',
      copy: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/>',
    };

    let results: Command[] = commands;
    let active = 0;

    /**
     * Subsequence matching, the way editors do it: "aii" finds "AI & AI
     * Integration". Consecutive hits and word-start hits score higher, so the
     * most obvious match floats to the top.
     */
    const score = (text: string, query: string): number => {
      const t = text.toLowerCase();
      const q = query.toLowerCase();
      if (!q) return 1;
      if (t.includes(q)) return 1000 - t.indexOf(q);

      let ti = 0;
      let points = 0;
      let streak = 0;
      for (const char of q) {
        const found = t.indexOf(char, ti);
        if (found === -1) return 0;
        streak = found === ti ? streak + 1 : 0;
        points += 1 + streak * 2 + (found === 0 || t[found - 1] === ' ' ? 3 : 0);
        ti = found + 1;
      }
      return points;
    };

    const render = () => {
      const query = input.value.trim();

      results = commands
        .map((cmd) => ({ cmd, s: score(`${cmd.label} ${cmd.keywords || ''}`, query) }))
        .filter((entry) => entry.s > 0)
        .sort((a, b) => b.s - a.s)
        .map((entry) => entry.cmd);

      if (active >= results.length) active = 0;

      empty?.toggleAttribute('hidden', results.length > 0);
      if (status) {
        status.textContent = results.length
          ? `${results.length} result${results.length === 1 ? '' : 's'}`
          : 'No results';
      }

      let html = '';
      let group = '';
      results.forEach((cmd, i) => {
        // Groups only make sense while browsing; once you type, relevance order
        // wins and the headings would lie about the grouping.
        if (!query && cmd.group !== group) {
          group = cmd.group;
          html += `<li class="cmdk__group" role="presentation">${group}</li>`;
        }
        html += `<li class="cmdk__item" id="cmdk-opt-${i}" role="option" data-index="${i}" aria-selected="${
          i === active
        }">
            <span class="cmdk__icon" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${
                     ICONS[cmd.icon] || ICONS.page
                   }</svg>
            </span>
            <span class="cmdk__label">${cmd.label}</span>
            ${cmd.hint ? `<span class="cmdk__hint">${cmd.hint}</span>` : ''}
          </li>`;
      });

      list.innerHTML = html;
      input.setAttribute('aria-activedescendant', results.length ? `cmdk-opt-${active}` : '');
    };

    const move = (delta: number) => {
      if (!results.length) return;
      active = (active + delta + results.length) % results.length;
      render();
      list.querySelector<HTMLElement>(`[data-index="${active}"]`)?.scrollIntoView({ block: 'nearest' });
    };

    const run = async (cmd: Command | undefined) => {
      if (!cmd) return;

      if (cmd.action === 'copy' && cmd.value) {
        try {
          await navigator.clipboard.writeText(cmd.value);
          if (status) status.textContent = 'Copied';
        } catch {
          if (status) status.textContent = 'Copy blocked by the browser';
        }
        return;
      }

      if (cmd.href) {
        dialog.close();
        window.location.href = cmd.href;
      }
    };

    // Whatever had focus when the palette opened gets it back on close, so a
    // keyboard visitor is returned to their place instead of to <body>.
    let opener: HTMLElement | null = null;

    const open = () => {
      if (dialog.open) return;
      opener = document.activeElement as HTMLElement | null;
      input.value = '';
      active = 0;
      render();
      dialog.showModal();
      input.focus();
    };

    dialog.addEventListener('close', () => {
      // Opened from a control: give that control its focus back. Opened from
      // the keyboard with nothing focused: land on the Find button so the tab
      // order resumes in the header rather than restarting at the top.
      const target =
        opener && opener.isConnected && opener !== document.body
          ? opener
          : document.querySelector<HTMLElement>('[data-cmdk-open]');
      target?.focus();
      opener = null;
    });

    // ⌘K on Mac, Ctrl+K elsewhere. "/" opens it too, the way search boxes do,
    // but not while the visitor is typing in a form.
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      const typing =
        target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.tagName === 'SELECT' ||
          target.isContentEditable);

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        dialog.open ? dialog.close() : open();
        return;
      }

      if (e.key === '/' && !typing && !dialog.open) {
        e.preventDefault();
        open();
      }
    });

    document.querySelectorAll('[data-cmdk-open]').forEach((trigger) => {
      trigger.addEventListener('click', open);
    });

    input.addEventListener('input', () => {
      active = 0;
      render();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        run(results[active]);
      }
    });

    list.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('[data-index]');
      if (item) run(results[Number(item.dataset.index)]);
    });

    list.addEventListener('mousemove', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('[data-index]');
      const index = item ? Number(item.dataset.index) : -1;
      if (index >= 0 && index !== active) {
        active = index;
        render();
      }
    });

    // Clicking the backdrop (i.e. outside the panel) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    render();
  }
</script>
