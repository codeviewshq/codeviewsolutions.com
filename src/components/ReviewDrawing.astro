---
interface Props {
  variant?: 'review' | 'services' | 'care' | 'contact' | 'missing';
}
const { variant = 'review' } = Astro.props;
const captions = {
  review: 'Clear structure. A useful next step. Every screen considered.',
  services: 'Refresh the experience. Maintain the site. Connect the systems.',
  care: 'One website, with design, content, and systems looked after together.',
  contact: 'Start with your website address and the problem you want to solve.',
  missing: 'One missing page. A clear route back to the rest of the site.',
};
---

<figure class="review-drawing" data-mark>
  <svg viewBox="0 0 480 270" aria-hidden="true" focusable="false">
    {variant === 'review' && <>
    <g class="drawing-ink">
      <rect class="drawing-paper" x="22" y="30" width="330" height="210" />
      <path d="M22 56h330" />
      <circle cx="36" cy="43" r="2" /><circle cx="46" cy="43" r="2" /><circle cx="56" cy="43" r="2" />
      <path d="M270 43h20m10 0h20M44 86h125m-125 13h98M44 120h140m-140 9h117" />
      <rect class="drawing-tint" x="215" y="77" width="115" height="83" />
      <path d="m230 139 25-29 22 18 18-24 20 35" />
      <rect x="44" y="148" width="83" height="23" />
      <path d="M44 190h286M135 190v31m97-31v31M44 205h65m52 0h45m51 0h73" />
      <rect class="drawing-paper" x="370" y="101" width="83" height="145" />
      <path d="M396 113h31M381 132h57m-57 12h42" />
      <rect class="drawing-tint" x="381" y="157" width="61" height="37" />
      <path d="M381 210h42m-42 10h57M406 235h12" />
    </g>
    <g class="drawing-red drawing-revision">
      <path data-draw d="M37 143q-7-7 1-12q7-6 14 0q7-6 14 0q7-6 14 0q7-6 14 0q7-6 14 0q7-6 14 0q11-4 13 6q8 7 0 14q7 8-1 15q-7 9-14 3q-7 6-14 0q-7 6-14 0q-7 6-14 0q-7 6-14 0q-7 6-14 0q-10 3-12-7q-7-6 0-12Z" />
      <path data-draw d="M143 157h27v-140h97" />
    </g>
    <g class="drawing-red">
      <path d="M22 255h330m-330-5v10m330-10v10M361 101v145m-5-145h10m-10 145h10" />
      <path d="m350 83 12 12m-12 0 12-12" />
    </g>
    <text x="277" y="21">CLEAR NEXT STEP</text>
    <text x="22" y="18">WEBSITE REVIEW</text>
    </>}
    {variant === 'services' && <>
      <g class="drawing-ink">
        <path d="M72 120h336M72 120v28m168-28v28m168-28v28" />
        <rect class="drawing-paper" x="165" y="30" width="150" height="73" />
        <path d="M165 48h150M181 64h70m-70 12h110m-110 12h90" />
        <rect class="drawing-paper" x="20" y="148" width="104" height="85" />
        <rect class="drawing-paper" x="188" y="148" width="104" height="85" />
        <rect class="drawing-paper" x="356" y="148" width="104" height="85" />
        <path d="M37 178h70m-70 12h45m-45 12h60M204 179h72m-72 13h72m-72 13h72M373 190h22m26 0h22" />
        <rect x="395" y="180" width="26" height="20" />
      </g>
      <g class="drawing-red drawing-revision">
        <path data-draw d="M32 215h80m-76-4-4 4 4 4m72-8 4 4-4 4M212 221l8 7 16-17M385 214h45m-8-5 8 5-8 5" />
        <path data-draw d="M240 103v17M20 248h440m-440-5v10m440-10v10" />
      </g>
      <text x="20" y="140">REFRESH</text><text x="188" y="140">CARE</text><text x="356" y="140">CONNECT</text>
      <text x="165" y="20">YOUR WEBSITE</text>
    </>}
    {variant === 'care' && <>
      <g class="drawing-ink">
        <path d="M130 70h220v130H130zM130 93h220M147 109h88m-88 13h62" />
        <rect class="drawing-tint" x="255" y="108" width="75" height="53" />
        <path d="M147 149h83m-83 15h60M147 184h183" />
        <path d="M75 42h330v192H75M75 42v192M75 112h55m220 0h55M240 42v28m0 130v34" />
        <circle class="drawing-paper" cx="75" cy="112" r="17" />
        <circle class="drawing-paper" cx="405" cy="112" r="17" />
        <circle class="drawing-paper" cx="240" cy="42" r="17" />
        <circle class="drawing-paper" cx="240" cy="234" r="17" />
      </g>
      <g class="drawing-red drawing-revision">
        <path data-draw d="M67 112l6 6 10-12M397 112l6 6 10-12M232 42l6 6 10-12M232 234l6 6 10-12" />
      </g>
      <text x="75" y="153" text-anchor="middle">DESIGN</text>
      <text x="405" y="153" text-anchor="middle">SYSTEMS</text>
      <text x="240" y="16" text-anchor="middle">ONGOING CARE</text>
      <text x="240" y="266" text-anchor="middle">CONTENT</text>
    </>}
    {variant === 'contact' && <>
      <g class="drawing-ink">
        <rect class="drawing-paper" x="55" y="30" width="240" height="204" />
        <path d="M55 59h240M75 83h112m-112 13h155M75 123h35m15 0h110M75 150h35m15 0h140M75 177h35m15 0h94M75 205h90" />
        <rect class="drawing-paper" x="340" y="90" width="92" height="98" />
        <path d="M356 111h59m-59 13h42m-42 44h59" />
      </g>
      <g class="drawing-red drawing-revision">
        <path data-draw d="M120 112h150v22H120zM306 145h24m-9-7 9 7-9 7m27-2 9 9 17-19" />
      </g>
      <text x="55" y="19">YOUR STARTING POINT</text><text x="340" y="79">NEXT STEP</text>
      <text x="75" y="49">WEBSITE · GOAL · QUESTION</text>
    </>}
    {variant === 'missing' && <>
      <g class="drawing-ink">
        <rect class="drawing-paper" x="35" y="34" width="140" height="190" />
        <path d="M55 65h99m-99 15h70M55 106h99m-99 15h82M55 151h99m-99 15h65" />
        <rect class="drawing-paper" x="304" y="54" width="140" height="190" />
        <path d="M324 85h99m-99 15h70M324 126h99m-99 15h82M324 171h99m-99 15h65" />
      </g>
      <g class="drawing-red drawing-revision">
        <path data-draw d="M195 83h90v110h-90zM222 120l35 35m0-35-35 35M285 213H190m9-7-9 7 9 7" />
      </g>
      <text x="35" y="22">DRAWING INDEX</text><text x="210" y="71">404</text><text x="304" y="42">BACK ON TRACK</text>
    </>}
  </svg>
  <figcaption>{captions[variant]}</figcaption>
</figure>

<style>
  .review-drawing { width: 100%; max-width: 30rem; justify-self: end; }
  svg { width: 100%; height: auto; overflow: visible; }
  .drawing-ink, .drawing-red { fill: none; stroke: var(--ink); stroke-width: 1.25; }
  .drawing-paper { fill: var(--stock); }
  .drawing-tint { fill: var(--stock-2); }
  .drawing-red { stroke: var(--red); }
  text { fill: var(--graphite); font: 500 9px var(--f-tech); letter-spacing: 0.7px; }
  figcaption { margin-top: 0.6rem; color: var(--graphite); font-size: 0.875rem; }
  .drawing-revision path { transition: stroke-dashoffset 1.2s var(--draw); }
  @media (max-width: 60rem) {
    .review-drawing { justify-self: start; }
  }
</style>
