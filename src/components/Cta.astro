---
/**
 * The closing sheet: an issue block. A drawing is issued for a purpose and
 * signed off, so the page ends the same way.
 */
import { site, hero } from '../data/site.js';
import { withBase } from '../utils/url.js';

interface Props {
  heading: string;
  headingAccent?: string;
  body: string;
  label?: string;
  sheet?: string;
  id?: string;
}

const {
  heading,
  headingAccent = '',
  body,
  label = hero.primaryCta.label,
  sheet = '06',
  id = 'issue',
} = Astro.props;
---

<section class="sh issue" id={id} data-sheet={sheet} data-mark>
  <p class="issue__seal">Issued<br />for<br />review</p>

  <h2 class="issue__title">{heading} {headingAccent}</h2>
  <p class="issue__body">{body}</p>

  <div class="stamp-row">
    <a class="stamp" href={withBase('/contact/')}>
      {label}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
        <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="square"></path>
      </svg>
    </a>
    <a class="stamp stamp--ghost" href={withBase('/services/')}>See the scope of work</a>
  </div>

  <dl class="signoff">
    <div>
      <dt>Prepared by</dt>
      <dd>{site.legalName}</dd>
    </div>
    <div>
      <dt>Reply within</dt>
      <dd>One business day</dd>
    </div>
    <div>
      <dt>Warranty</dt>
      <dd>90 days after handover</dd>
    </div>
    <div>
      <dt>Ownership</dt>
      <dd>Yours on delivery</dd>
    </div>
  </dl>
</section>
