---
import { site } from "../data/site.js";
import { withBase } from "../utils/url.js";
import Icon from "./Icon.astro";
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "Tell us what’s getting in the way.",
  body = "A short conversation is often enough to see a sensible next step. We’ll listen, ask a few questions, and give you an honest view.",
} = Astro.props;
---

<section class="closing section" data-reveal>
  <div class="closing__arc" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="container closing__content">
    <h2>{heading}</h2>
    <p>{body}</p>
    <div class="actions">
      <a class="button button--inverse" href={withBase("/contact/")}>
        Let’s talk
        <Icon />
      </a>
      <span class="closing__note">
        The first consultation is free. No obligation.
      </span>
    </div>
    <a class="closing__email" href={`mailto:${site.email}`}>
      {site.email}
    </a>
  </div>
</section>
