---
/**
 * A full clause on the services sheet: the prose, its numbered schedule of
 * inclusions, and the parameter strip that a spec entry carries.
 */
interface Entry {
  key: string;
  value: string;
}

interface Props {
  id: string;
  index: number;
  name: string;
  body: string;
  includes?: string[];
  meta?: Entry[];
}

const { id, index, name, body, includes = [], meta = [] } = Astro.props;
const paragraphs = body.split('\n\n').filter(Boolean);
---

<section class="detail" id={id} data-sheet={String(index + 1).padStart(2, '0')} data-mark>
  <header class="detail__head">
    <h2 class="detail__title">{name}</h2>
    <p class="detail__no">Clause {index + 1}.0</p>
  </header>

  <div class="detail__grid">
    <div class="prose">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>

    {
      includes.length > 0 && (
        <ol class="schedule">
          {includes.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
      )
    }
  </div>

  {
    meta.length > 0 && (
      <dl class="facts">
        {meta.map((entry) => (
          <div>
            <dt>{entry.key}</dt>
            <dd>{entry.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
</section>
