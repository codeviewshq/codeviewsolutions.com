---
/** The sheet's bottom margin: a revision table. */
import { site, nav } from '../data/site.js';
import { withBase } from '../utils/url.js';
import { isPlaceholder } from '../utils/placeholder.js';

const emailReady = !isPlaceholder(site.email);
const phoneReady = !isPlaceholder(site.phone);
const links = site.links.filter((l) => !isPlaceholder(l.href));
---

<footer class="foot">
  <div>{site.legalName}</div>
  <div>{site.serviceArea}</div>
  <div>
    {
      phoneReady ? (
        <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a>
      ) : emailReady ? (
        <a href={`mailto:${site.email}`}>{site.email}</a>
      ) : (
        'Reply within one business day'
      )
    }
  </div>
  <div>
    {nav.map((item, i) => (
      <>{i > 0 && ' · '}<a href={withBase(item.href)}>{item.label}</a></>
    ))}
    {links.map((l) => <> · <a href={l.href}>{l.label}</a></>)}
  </div>
</footer>
