---
/**
 * The shell every page renders into.
 *
 * THE REDLINE: the site is a technical specification sheet. This layout owns
 * the parts of that sheet that never change — the edge, the registration
 * marks, the masthead, and the foot. Each page supplies its own sheets.
 */
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/martian-mono/wght.css';
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { site, nav } from '../data/site.js';
import { withBase } from '../utils/url.js';

interface Props {
  title: string;
  description: string;
  /** Path to a social share image inside /public. Must resolve absolute. */
  image?: string;
}

const { title, description, image = '/og.png' } = Astro.props;

// Open Graph requires absolute URLs — relative ones produce no preview
// anywhere. Astro.site is set in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// withBase, because /og.png lives under the base path on GitHub Pages.
const ogImage = new URL(withBase(image), Astro.site).href;

// Marks the current page in the band so the nav says where you are.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHere = (href: string) => {
  const target = withBase(href).replace(/\/+$/, '') || '/';
  return target === here;
};

// Helps Google associate the site with the business and its service area.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  description,
  areaServed: 'US',
  // No address is published: the work is remote and the service area is the
  // whole country, so `areaServed` above carries the geography on its own.
  knowsAbout: ['Website redesign', 'Website maintenance', 'Web hosting and performance'],
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.legalName} />
    <meta name="generator" content={Astro.generator} />

    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#EFEEE7" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.legalName} — ${site.tagline}`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <!--
      THESIS: This site is a technical specification sheet for the visitor's own
      website. It refuses the category default — a gradient hero floating above
      three equal service cards — because the entire promise is that somebody
      looked, wrote it down, ruled it, and signed it.
      OWN-WORLD: Drafting stock #EFEEE7, the logo's own navy #000036 as ink, one
      spot revision red #D8261B, graphite rule. An ISO line-weight hierarchy
      (hairline / keyline / division / sheet edge) carries every division; no
      shadows, no radii, no gradients. Archivo for sheet lettering, Martian Mono
      for title-block fields, figures, and dimensions. Every element occupies
      whole cells of one modular grid.
      STORY: A non-technical owner sees their website treated as a documented
      asset with an accountable owner and a published price, and books the free
      review.
      FIRST VIEWPORT: Sheet 01. A 3px sheet edge frames the viewport with corner
      registration marks. The mark and name sit in one masthead row above a
      rule, headline set enormous beneath it, the free review note in
      red on a leader line pointing back at it, the stamped primary action
      beneath, and a ruled title block. That block carries five visitor-facing
      fields (first step, ongoing care, based nearby, built for, live sheet
      position) rather than a drafting CLIENT/SHEET/REV strip: real facts beat
      cosplay, and it keeps the mono on measurement instead of costume.
      FORM: Technical specification sheet + drafting-office redline markup;
      candidate 7 of the grounded list; seed key 685831a9.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, DESIGN.md, and every shipping raster
      carrying its provenance.
    -->
    <a class="skip" href="#main">Skip to content</a>

    <div class="sheet">
      <!-- MASTHEAD — one row: the mark and name together, then the routes. -->
      <header class="mast">
        <a class="mast__id" href={withBase('/')} aria-label={`${site.name} — home`}>
          <img
            class="mast__logo"
            src={withBase('/brand/lockup.png')}
            width="513"
            height="128"
            alt={site.name}
            decoding="async"
            fetchpriority="high"
          />
        </a>

        <nav class="mast__nav" aria-label="Main">
          {
            nav.map((item) => (
              <a href={withBase(item.href)} aria-current={isHere(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <button class="ts__find" type="button" data-cmdk-open>
          Find <kbd data-mod>Ctrl</kbd><kbd>K</kbd>
        </button>
      </header>

      <div class="body">
        <main id="main">
          <slot />
        </main>

        <Footer />
      </div>
    </div>

    <CommandPalette />

    <script>
      import { initBilling } from '../scripts/billing.js';
      initBilling();

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* --- Modifier key -----------------------------------------------------
         The palette accepts Meta or Control; the hint should name whichever
         one the visitor actually has, rather than showing a Mac glyph to
         everybody. Rendered as Ctrl so the no-JS default is the common case. */
      if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
        document.querySelectorAll('[data-mod]').forEach((el) => {
          el.textContent = '\u2318';
        });
      }

      /* --- Revision cloud ---------------------------------------------------
         A real revision cloud is a run of outward arcs around the thing being
         questioned. Walking the perimeter beats any fixed path: the phrase can
         rewrap at any width and the cloud still fits it. */
      const cloudPath = (x: number, y: number, w: number, h: number) => {
        // Small, even scallops — a cloud's bumps do not grow with the type,
        // and a large bulge collides with neighbouring lines when the
        // headline is set tight.
        const r = Math.min(18, Math.max(7, h / 4.2));
        const nx = Math.max(3, Math.round(w / (r * 1.75)));
        const ny = Math.max(2, Math.round(h / (r * 1.75)));
        const sx = w / nx;
        const sy = h / ny;
        const arc = (dx: number, dy: number) => `a${r},${r} 0 0,1 ${dx},${dy}`;
        let d = `M${x},${y}`;
        for (let i = 0; i < nx; i++) d += arc(sx, 0);
        for (let i = 0; i < ny; i++) d += arc(0, sy);
        for (let i = 0; i < nx; i++) d += arc(-sx, 0);
        for (let i = 0; i < ny; i++) d += arc(0, -sy);
        return `${d}Z`;
      };

      /* Under a phone's column a cloud cannot fit around a phrase without
         running off the sheet and into the lines above and below. A marker
         underlines instead of circling when there is no room to circle, so
         that is what the narrow layout draws: same device, same red, sized to
         the space it actually has. */
      const wavyUnderline = (x: number, y: number, w: number) => {
        const n = Math.max(3, Math.round(w / 11));
        const dx = w / n;
        let d = `M${x.toFixed(1)},${y.toFixed(1)}`;
        for (let i = 0; i < n; i++) {
          d += `q${(dx / 2).toFixed(1)},${i % 2 ? 3.5 : -3.5} ${dx.toFixed(1)},0`;
        }
        return d;
      };

      /* Each marked sheet measures its own cloud and leader off its own live
         elements, so every page can carry a finding rather than only the hero. */
      const layoutMarkup = () => {
        document.querySelectorAll<SVGSVGElement>('[data-markup]').forEach(markOne);
      };

      function markOne(svg: SVGSVGElement) {
        const scope = svg.closest('[data-mark]') ?? document;
        const target = scope.querySelector<HTMLElement>('[data-cloud]');
        const note = scope.querySelector<HTMLElement>('[data-note]');
        if (!target || !note) return;

        const base = svg.getBoundingClientRect();
        svg.setAttribute('viewBox', `0 0 ${base.width} ${base.height}`);

        // A phrase can wrap. Its element box is then the union of both lines —
        // a rectangle that mostly covers empty stock and the lines around it,
        // so a cloud drawn on it hugs nothing and, sitting behind the type,
        // shows up only as a stray arc in the corner. Mark the line that
        // carries most of the phrase instead.
        const phraseRange = document.createRange();
        phraseRange.selectNodeContents(target);
        const phraseLines = [...phraseRange.getClientRects()].filter(
          (r) => r.width > 2 && r.height > 2
        );
        const t = phraseLines.length
          ? phraseLines.reduce((a, b) => (b.width > a.width ? b : a))
          : target.getBoundingClientRect();
        const pad = 10;
        const cx = t.left - base.left - pad;
        const cy = t.top - base.top - pad * 0.6;
        const cw = t.width + pad * 2;
        const ch = t.height + pad * 1.2;
        const narrow = matchMedia('(max-width: 44rem)').matches;
        svg
          .querySelector('.mk-cloud')
          ?.setAttribute(
            'd',
            narrow
              ? wavyUnderline(t.left - base.left, t.bottom - base.top + 2, t.width)
              : cloudPath(cx, cy, cw, ch)
          );

        // The leader runs out of the note and back to the cloud. On a print it
        // is routed around the drawing, never across it: a line laid over type
        // reads as a strike-through, which is the opposite of what a leader
        // means.
        //
        // Rather than assume where the note sits — it moves to the margin on a
        // wide sheet and under the copy on a narrow one — several routes are
        // proposed and the first one that touches no lettering is drawn. If
        // none is clear, no leader is drawn at all.
        const n = note.getBoundingClientRect();
        const leader = svg.querySelector('.mk-leader');
        const dot = svg.querySelector('.mk-dot');

        // Every line of type on this sheet, as glyph boxes. An element box is
        // no use here: a heading is a block that spans its container, so it
        // would report the whole width as occupied when its lines stop short.
        const lines: DOMRect[] = [];
        const collect = (node: Node) => {
          node.childNodes.forEach((child) => {
            if (child.nodeType === 3) {
              if (!child.textContent || !child.textContent.trim()) return;
              const range = document.createRange();
              range.selectNodeContents(child);
              for (const r of range.getClientRects()) {
                if (r.width > 2 && r.height > 2) lines.push(r);
              }
            } else if (child.nodeType === 1) {
              const el = child as HTMLElement;
              if (el.closest('svg') || el === note || note.contains(el)) return;
              if (getComputedStyle(el).display === 'none') return;
              collect(el);
            }
          });
        };
        collect(scope === document ? document.body : (scope as Element));

        // The cloud is already a mark on the phrase, so the line is free to
        // finish inside it.
        // Narrow sheets get an underline instead of a cloud, so the leader has
        // to aim at whichever mark was actually drawn; aiming at the cloud's
        // box on a phone lands the tip in clear space beside the phrase.
        const markL = base.left + (narrow ? t.left - base.left : cx);
        const markT = base.top + (narrow ? t.bottom - base.top - 2 : cy);
        const markW = narrow ? t.width : cw;
        const markH = narrow ? 10 : ch;
        const inCloud = (x: number, y: number) =>
          x >= markL - 4 && x <= markL + markW + 4 && y >= markT - 4 && y <= markT + markH + 4;

        const clean = (pts: number[][]) => {
          for (let i = 1; i < pts.length; i++) {
            const [x1, y1] = pts[i - 1];
            const [x2, y2] = pts[i];
            const steps = Math.max(8, Math.round(Math.hypot(x2 - x1, y2 - y1) / 4));
            for (let k = 0; k <= steps; k++) {
              const x = base.left + x1 + ((x2 - x1) * k) / steps;
              const y = base.top + y1 + ((y2 - y1) * k) / steps;
              if (inCloud(x, y)) continue;
              for (const r of lines) {
                if (x > r.left + 2 && x < r.right - 2 && y > r.top + 2 && y < r.bottom - 2) return false;
              }
            }
          }
          return true;
        };

        // Anchors, in sheet coordinates.
        const noteT = n.top - base.top;
        const noteB = n.bottom - base.top;
        const noteMidX = n.left - base.left + n.width / 2;
        const noteR = n.right - base.left + 6;
        const noteMidY = noteT + n.height / 2;
        const entryY = narrow ? t.bottom - base.top + 3 : cy + ch * 0.55;
        const below = noteT > cy + ch;
        const stubY = below ? noteT - 6 : noteB + 6;   // leave from the near edge
        const leftShoulderX = narrow ? t.left - base.left + t.width * 0.5 : cx + cw * 0.18;
        const leftShoulderY = narrow ? t.bottom - base.top + 3 : cy + ch + 6;
        const shoulderRightX = narrow ? t.right - base.left : cx + cw;

        let clearX = 0;
        const bandTop = Math.min(entryY, noteMidY);
        const bandBottom = Math.max(entryY, noteMidY);
        for (const r of lines) {
          if (r.bottom - base.top <= bandTop + 2 || r.top - base.top >= bandBottom - 2) continue;
          clearX = Math.max(clearX, r.right - base.left);
        }

        const routes: Array<{ pts: number[][]; tip: number[] }> = [
          // Straight up out of the note into the cloud's underside.
          { pts: [[noteMidX, stubY], [noteMidX, leftShoulderY]], tip: [noteMidX, leftShoulderY] },
          // Up the note's own column, then in level with the phrase.
          { pts: [[noteMidX, stubY], [noteMidX, entryY], [shoulderRightX, entryY]], tip: [shoulderRightX, entryY] },
          // Out of the side, then up to the cloud's lower-left shoulder.
          { pts: [[noteR, noteMidY], [Math.max(noteR + 40, leftShoulderX - 90), noteMidY], [leftShoulderX, leftShoulderY]], tip: [leftShoulderX, leftShoulderY] },
          // Around the outside of every line, then back in level with the phrase.
          { pts: [[noteR, noteMidY], [clearX + 16, noteMidY], [clearX + 16, entryY], [shoulderRightX, entryY]], tip: [shoulderRightX, entryY] },
        ];

        const route = routes.find(
          (r) => r.pts.every(([x, y]) => x > -4 && x < base.width + 4 && y > -4) && clean(r.pts)
        );

        if (route) {
          leader?.setAttribute(
            'd',
            route.pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ')
          );
          dot?.setAttribute('cx', route.tip[0].toFixed(1));
          dot?.setAttribute('cy', route.tip[1].toFixed(1));
        } else {
          // No honest route. The cloud still marks the phrase and the note
          // still carries its revision tag; a line through the copy would say
          // the opposite of what it means.
          leader?.setAttribute('d', '');
          dot?.setAttribute('cx', '-99');
          dot?.setAttribute('cy', '-99');
        }
      }

      /* --- The redline pass -------------------------------------------------
         Markup does not fade in. It is drawn, the way a hand draws it: each
         stroke runs its own length once its section is on screen.

         A dash-offset transition can only animate from a value the browser has
         actually rendered. `.is-drawn` forces the offset to 0 with !important,
         so if that class lands in the same frame the offset is armed, there is
         no starting point and the stroke snaps instead of drawing. Arming is
         therefore done with transitions suppressed, then flushed, so the armed
         length is a real rendered value before anything animates.

         Re-measuring (fonts, resize) must not re-arm a stroke that has already
         been drawn, or the mark would wipe itself and redraw on every resize. */
      function arm(scope: ParentNode) {
        const strokes = [...scope.querySelectorAll<SVGGeometryElement>('[data-draw]')];

        strokes.forEach((el) => {
          const len = el.getTotalLength ? el.getTotalLength() : 0;
          if (!len) return;
          const done = reduced || !!el.closest('[data-mark]')?.classList.contains('is-drawn');
          el.style.transition = 'none';
          el.style.strokeDasharray = `${len}`;
          el.style.strokeDashoffset = done ? '0' : `${len}`;
        });

        // Flush the armed values into a real style resolution, then hand the
        // property back to the stylesheet so its own timings apply.
        if (strokes.length) void strokes[0].getBoundingClientRect();
        strokes.forEach((el) => {
          el.style.transition = '';
        });
      }

      /* The draw must start from a final measurement, or a re-measure lands
         mid-stroke and snaps it to finished. So: arm, let the webfont settle,
         arm again, and only then let anything be observed into view. */
      const observe = () => {
        if (reduced) {
          document.querySelectorAll('[data-mark]').forEach((el) => el.classList.add('is-drawn'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-drawn');
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.15 }
        );
        document.querySelectorAll('[data-mark]').forEach((el) => io.observe(el));
      };

      layoutMarkup();
      arm(document);

      // Webfonts move the phrase the cloud is measured from. Wait for them, but
      // never let a font that fails to load hold the markup hostage.
      const settled =
        'fonts' in document
          ? Promise.race([
              document.fonts.ready,
              new Promise((resolve) => setTimeout(resolve, 1500)),
            ])
          : Promise.resolve();

      settled
        .then(() => {
          layoutMarkup();
          arm(document);
        })
        .catch((err) => {
          // A measurement failure must never leave the markup permanently
          // invisible: the strokes are armed to their undrawn length, so a
          // throw here would strand them at zero-length forever.
          console.error('[markup] measurement failed', err);
        })
        .finally(() => observe());

      // A resize re-measures. Strokes already drawn keep their finished state
      // rather than wiping and redrawing every time the window moves. One
      // measurement per frame: a drag-resize fires this continuously, and the
      // measure walks every text node on the sheet.
      let remeasure = 0;
      addEventListener('resize', () => {
        if (remeasure) return;
        remeasure = requestAnimationFrame(() => {
          remeasure = 0;
          layoutMarkup();
          arm(document);
        });
      });

      /* --- Pointer guides ---------------------------------------------------
         The sheet is live under the pointer: two hairlines track it across the
         title sheet, the way a drafting table's rule does. Fine pointers only. */
      const stage = document.querySelector<HTMLElement>('[data-stage]');

      if (stage && matchMedia('(pointer: fine)').matches && !reduced) {
        let frame = 0;
        let px = 0;
        let py = 0;

        const paint = () => {
          frame = 0;
          const r = stage.getBoundingClientRect();
          stage.style.setProperty('--gx', `${px - r.left}px`);
          stage.style.setProperty('--gy', `${py - r.top}px`);
        };

        stage.addEventListener(
          'pointermove',
          (e) => {
            px = e.clientX;
            py = e.clientY;
            stage.dataset.live = 'true';
            if (!frame) frame = requestAnimationFrame(paint);
          },
          { passive: true }
        );
        stage.addEventListener('pointerleave', () => {
          stage.dataset.live = 'false';
        });
      }

      /* Deep links land short when the browser jumps before the webfont has
         settled, so re-assert the target once layout is final. */
      if (location.hash) {
        const target = document.querySelector(location.hash);
        if (target) {
          const jump = () => target.scrollIntoView({ block: 'start', behavior: 'instant' });
          jump();
          addEventListener('load', jump, { once: true });
        }
      }
    </script>
  </body>
</html>
