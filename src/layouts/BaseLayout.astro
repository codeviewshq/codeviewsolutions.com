---
import "@fontsource-variable/manrope/wght.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import Icon from "../components/Icon.astro";
import logoSvg from "../../public/brand/lockup.svg?raw";
import { site, nav } from "../data/site.js";
import { withBase } from "../utils/url.js";
interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = "/og.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase(image), Astro.site).href;
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHere = (href: string) =>
  (withBase(href).replace(/\/+$/, "") || "/") === here;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  description,
  areaServed: "US",
  knowsAbout: [
    "Digital consulting",
    "Website design and development",
    "Digital products and portals",
    "API and third-party integrations",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.legalName} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F7F8FC" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const dark = matchMedia("(prefers-color-scheme: dark)");
        let theme;
        let motion;
        try {
          theme = localStorage.getItem("codeview-theme");
          motion = localStorage.getItem("codeview-motion");
        } catch {}
        root.dataset.theme =
          theme === "light" || theme === "dark"
            ? theme
            : dark.matches
              ? "dark"
              : "light";
        root.dataset.motion =
          matchMedia("(prefers-reduced-motion: reduce)").matches ||
          motion === "paused"
            ? "paused"
            : "running";
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute(
            "content",
            root.dataset.theme === "dark" ? "#090D24" : "#F7F8FC",
          );
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="header">
      <div class="header__inner container">
        <a class="brand" href={withBase("/")} aria-label={`${site.name} home`}>
          <span set:html={logoSvg} />
        </a>
        <nav class="desktop-nav" aria-label="Main">
          {nav.map((item) => (
            <a
              href={withBase(item.href)}
              aria-current={isHere(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header__tools">
          <button
            class="icon-button search-trigger"
            type="button"
            data-cmdk-open
            aria-label="Search the site"
          >
            <Icon name="search" />
          </button>
          <button
            class="icon-button theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="Change color theme"
          >
            <Icon name="sun" class="theme-sun" />
            <Icon name="moon" class="theme-moon" />
          </button>
          <a class="header__consult" href={withBase("/contact/")}>
            Let’s talk
            <Icon name="diagonal" />
          </a>
          <button
            class="icon-button menu-toggle"
            type="button"
            data-menu-toggle
            aria-label="Open navigation"
            aria-expanded="false"
            aria-controls="mobile-navigation"
          >
            <Icon name="menu" class="menu-open" />
            <Icon name="close" class="menu-close" />
          </button>
        </div>
      </div>
      <nav
        class="mobile-nav container"
        id="mobile-navigation"
        aria-label="Mobile"
      >
        {nav.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isHere(item.href) ? "page" : undefined}
          >
            {item.label}
            <Icon name="diagonal" />
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CommandPalette />
    <script>
      import { initSite } from "../scripts/site";
      initSite();
    </script>
  </body>
</html>
