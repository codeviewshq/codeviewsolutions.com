---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import ProjectCta from '../components/ProjectCta.astro';
import { services, process, site } from '../data/site.js';
import { url } from '../utils/url.js';
---
<Layout>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy"><h1>Better software.<br />Stronger business.</h1><p class="hero-lede">Custom software, technical consulting, and practical AI integration.</p><div class="hero-actions"><svg class="signal-route" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 50H740L840 30H985M970 16L988 30L970 44" /></svg><a class="button" href={url('/contact/')}>Discuss your project <Icon /></a><a class="hero-secondary" href={url('/services/')}>Explore our services</a></div><div class="hero-assurances"><span><Icon name="shield" size={20} /> Clear scope, agreed upfront</span><span><Icon name="lock" size={20} /> You own your code</span></div></div>
      <figure class="hero-art"><img src={url('/images/software-illustration.webp')} width="1758" height="878" alt="Illustration of a customer portal connected to an automated workflow" fetchpriority="high" /><figcaption>Illustrative software</figcaption></figure>
    </div>
  </section>
  <section class="home-services section">
    <div class="wrap">
      <ol class="process-track" aria-label="Our process">{process.map((step, i) => <li><span>0{i + 1}</span><strong>{step.title}</strong><span class="track-line" aria-hidden="true"></span></li>)}</ol>
      <div class="service-preview-grid">{services.map(service => <a class="service-preview" href={url(`/services/${service.slug}/`)}><Icon name={service.icon} size={32} /><h2>{service.name}</h2><p>{service.summary}</p><span class="service-preview__link">Explore the service <Icon size={20} /></span></a>)}</div>
      <a class="care-link" href={url('/website-care/')}>Website redesign & monthly care also available <Icon size={18} /></a>
    </div>
  </section>
  <section class="section problem-section"><div class="wrap section-split"><div><h2>Less friction.<br />More forward.</h2><p class="lede">Technology should make the business easier to run.</p></div><div class="problem-copy"><p>When information lives in different places, simple tasks take too long, and nobody owns the next technical decision, growth gets harder than it needs to be.</p><p>We connect the business problem to the right solution. Sometimes that means a new application. Sometimes it means improving the systems you already have. We help you decide before you invest.</p><a class="text-link" href={url('/about/')}>Get to know CodeView <Icon size={20} /></a></div></div></section>
  <section class="section section--tint" id="process"><div class="wrap"><div class="section-heading"><h2>A clear way to move forward.</h2><p>You bring the business problem. We help turn it into a practical next step.</p></div><div class="process-grid">{process.map((step, i) => <article><span class="step-number">0{i + 1}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div></div></section>
  <section class="section"><div class="wrap section-split"><div><h2>A few things<br />worth knowing.</h2><p>Clear answers before the first conversation.</p></div><Faq /></div></section>
  <ProjectCta />
</Layout>
