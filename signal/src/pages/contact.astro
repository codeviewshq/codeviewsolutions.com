---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, services } from '../data/site.js';
import { contactEndpoint } from '../utils/url.js';
const endpoint = contactEndpoint(site.contactEndpoint);
const options = [...services.map(s => ({ value: s.slug, label: s.name })), { value: 'website-review', label: 'Free website review' }, { value: 'website-care', label: 'Website care' }, { value: 'not-sure', label: 'Not sure yet' }];
---
<Layout title="Discuss Your Project — CodeView Solutions" description="Talk to CodeView Solutions about software development, consulting, AI integration, or website care. Reply within one business day.">
  <section class="inner-hero contact-hero"><div class="wrap"><h1>What would you<br />like to make better?</h1><p class="lede">A business problem is enough to start. We’ll help you make the next step clear.</p><a class="button" href={site.phoneHref}><Icon name="phone" size={20} /> Call {site.phone}</a><p class="quiet-note">Reply within one business day.</p></div></section>
  <section class="section"><div class="wrap contact-grid">
    <div class="contact-main">
      <h2>{endpoint ? 'Tell us about your project.' : 'Prepare your project brief.'}</h2>
      <p>{endpoint ? 'A few details help us understand what you need. We’ll reply within one business day.' : 'Prefer to gather your thoughts first? Write a short brief below and copy it for your conversation. Online enquiries are not enabled yet; call us to discuss it.'}</p>
      <form class="contact-form" action={endpoint || undefined} method={endpoint ? 'POST' : undefined} data-brief-form={endpoint ? undefined : ''} data-contact-form={endpoint ? '' : undefined}>
        <div class="field-pair"><div class="field"><label for="name">Your name{endpoint && <span> *</span>}</label><input id="name" name="name" autocomplete="name" required={Boolean(endpoint)} maxlength="120" /></div><div class="field"><label for="email">Work email{endpoint && <span> *</span>}</label><input id="email" name="email" type="email" autocomplete="email" required={Boolean(endpoint)} maxlength="254" /></div></div>
        <div class="field-pair"><div class="field"><label for="company">Company</label><input id="company" name="company" autocomplete="organization" maxlength="160" /></div><div class="field"><label for="service">What do you need?</label><select id="service" name="service"><option value="">Select a service</option>{options.map(option => <option value={option.value}>{option.label}</option>)}</select></div></div>
        <div class="field"><label for="message">What would you like to improve? *</label><textarea id="message" name="message" rows="5" required minlength="10" maxlength="6000" placeholder="Tell us what you want to do, what is getting in the way, and any timing we should know about."></textarea><span class="field-hint">For a website review, include your website address.</span></div>
        {endpoint && <div class="honeypot" aria-hidden="true"><label for="_gotcha">Leave this empty</label><input id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" /></div>}
        <input name="plan" type="hidden" data-plan-input /><input name="_subject" type="hidden" value="CodeView Solutions project enquiry" />
        {endpoint ? <button class="button" type="submit">Send your enquiry <Icon /></button> : <button class="button brief-button" type="button" data-copy-brief hidden>Copy project brief <Icon /></button>}
        <p class="form-status" role="status" aria-live="polite"></p>
        <noscript>{!endpoint && <p>You can use these fields to prepare your thoughts. Call the number above to discuss your project.</p>}</noscript>
      </form>
      {!endpoint && <div class="brief-output" hidden><label for="brief-result">Your project brief</label><textarea id="brief-result" readonly rows="8"></textarea><p>Select and copy this text if your browser does not allow automatic copying.</p></div>}
      <p class="contact-privacy">{endpoint ? 'Your details are used to respond to your enquiry. Please do not include passwords or confidential documents.' : 'This brief stays in your browser and is not submitted. Please do not include passwords or confidential documents.'}</p>
    </div>
    <aside class="contact-aside"><h2>A clear first conversation.</h2><ul class="contact-points"><li><Icon name="check" />Describe the problem in plain English.</li><li><Icon name="check" />We explain a sensible starting point.</li><li><Icon name="check" />Scope and cost are agreed before work begins.</li></ul><div class="contact-detail"><h3>Talk to us</h3><a href={site.phoneHref}>{site.phone}</a>{site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}</div><div class="contact-detail"><h3>Where we work</h3><p>With businesses across the United States.</p></div></aside>
  </div></section>
</Layout>
