---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/site.js';
import { url } from '../utils/url.js';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand-link" href={url('/')} aria-label="CodeView Solutions — home"><Logo /></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" hidden>
      <span>Menu</span><span class="menu-toggle__lines" aria-hidden="true"></span>
    </button>
    <nav class="site-nav" id="site-navigation" aria-label="Main navigation">
      {nav.map(item => <a href={url(item.href)} aria-current={path.startsWith(url(item.href)) ? 'page' : undefined}>{item.label}</a>)}
      <a class="nav-contact" href={url('/contact/')} aria-current={path.startsWith(url('/contact/')) ? 'page' : undefined}>Let’s talk <Icon size={18} /></a>
    </nav>
  </div>
</header>
