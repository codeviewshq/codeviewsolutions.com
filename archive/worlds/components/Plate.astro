---
/**
 * THE INSTRUCTION BOOK — an authored part.
 *
 * A true 2:1 isometric brick, generated from a stud count rather than drawn by
 * hand, so a 1×2 and a 2×4 are the same object at different sizes and the
 * whole parts inventory stays one system. Faces are shaded by mixing the base
 * colour toward the navy ink; the keyline is the manual's own line weight.
 *
 * This is the world's icon system. Nothing on the instruction pages uses a
 * generic icon set.
 */
interface Props {
  /** studs along the x axis */
  w?: number;
  /** studs along the y axis */
  d?: number;
  /** base colour of the top face */
  color?: string;
  /** overall pixel width; the height follows from the geometry */
  size?: number;
  class?: string;
  label?: string;
}

const { w = 2, d = 2, color = '#D8232A', size = 96, class: className = '', label } = Astro.props;

const SX = 26; // half stud width in screen px
const SY = 15; // half stud depth in screen px
const BH = 22; // brick body height
const SH = 8; // stud height
const RX = 9.5;
const RY = 5.4;

// Top face, walked from the far corner.
const A = [0, 0];
const B = [w * SX, w * SY];
const C = [w * SX - d * SX, w * SY + d * SY];
const D = [-d * SX, d * SY];

const pt = (p: number[]) => `${p[0]},${p[1]}`;
const down = (p: number[]) => [p[0], p[1] + BH];

const top = [A, B, C, D].map(pt).join(' ');
const right = [B, C, down(C), down(B)].map(pt).join(' ');
const left = [D, C, down(C), down(D)].map(pt).join(' ');

// Studs sit on the top face at the centre of each stud cell.
const studs: number[][] = [];
for (let i = 0; i < w; i++) {
  for (let j = 0; j < d; j++) {
    studs.push([(i + 0.5) * SX - (j + 0.5) * SX, (i + 0.5) * SY + (j + 0.5) * SY]);
  }
}

const minX = -d * SX - RX - 3;
const maxX = w * SX + RX + 3;
const minY = -SH - RY - 3;
const maxY = w * SY + d * SY + BH + 3;
const vbW = maxX - minX;
const vbH = maxY - minY;
---

<svg
  class={`plate ${className}`}
  viewBox={`${minX} ${minY} ${vbW} ${vbH}`}
  width={size}
  height={(size * vbH) / vbW}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  style={`--plate: ${color}`}
>
  <g class="plate__g">
    <polygon class="plate__left" points={left} />
    <polygon class="plate__right" points={right} />
    <polygon class="plate__top" points={top} />
    {
      studs.map((s) => (
        <g>
          <path
            class="plate__stud-wall"
            d={`M${s[0] - RX},${s[1]} v${-SH} a${RX},${RY} 0 0 1 ${RX * 2},0 v${SH} a${RX},${RY} 0 0 1 ${-RX * 2},0 z`}
          />
          <ellipse class="plate__stud-top" cx={s[0]} cy={s[1] - SH} rx={RX} ry={RY} />
        </g>
      ))
    }
  </g>
</svg>
