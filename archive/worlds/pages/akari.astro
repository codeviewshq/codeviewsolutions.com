---
import AkariLayout from '../../layouts/AkariLayout.astro';
import Logo from '../../components/Logo.astro';
import Seal from '../../components/Seal.astro';
import { site, nav, hero, services, process, credibility, sections, ctas, meta } from '../../data/site.js';
import { withBase } from '../../utils/url.js';

const [leadBefore, leadAfter] = hero.headlineLead.split('an asset');
const [firstFact, ...restFacts] = hero.facts;
---

<AkariLayout title={meta.home.title} description={meta.home.description}>
  <div class="room" id="room">
    <header class="rail">
      <a class="rail__brand" href={withBase('/')}>
        <Logo class="rail__mark" />
        <span class="rail__name">{site.legalName}</span>
      </a>
      <nav aria-label="Main">
        {nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      </nav>
    </header>

    <!-- THE FIRST ROOM -->
    <section class="lanterns">
      <div>
        <h1 class="title">{leadBefore}<em>an asset</em>{leadAfter} {hero.headlineAccent}</h1>
        <p class="sub">{hero.body}</p>

        <p class="assure">
          <Seal />
          <span>{hero.assurance}</span>
        </p>

        <div class="actions">
          <a class="btn" href={withBase(hero.primaryCta.href)}>{hero.primaryCta.label}</a>
          <a class="btn btn--paper" href={withBase(hero.secondaryCta.href)}>{hero.secondaryCta.label}</a>
        </div>
      </div>

      <div class="volume volume--moon">
        <p class="moon__value">
          <span class="moon__key">{firstFact.key}</span>
          {firstFact.value}
        </p>
      </div>
    </section>

    <div class="shelf">
      {
        restFacts.map((fact) => (
          <div class="volume">
            <span class="moon__key">{fact.key}</span>
            <p class="moon__value">{fact.value}</p>
          </div>
        ))
      }
    </div>

    <!-- FORMS -->
    <section class="chapter">
      <div class="chapter__head">
        <h2 class="chapter__title">{sections.homeServices.heading}</h2>
        <p class="chapter__lede">{sections.homeServices.lede}</p>
      </div>

      <div class="forms">
        {
          services.map((service) => (
            <a class="form volume volume--tall" href={withBase(`/services/#${service.id}`)}>
              <Seal />
              <span>
                <span class="form__name">{service.name}</span>
                <span class="form__desc">{service.summary}</span>
              </span>
              <span class="form__meta">
                {
                  service.meta.map((m) => (
                    <span>
                      {m.key}
                      <b>{m.value}</b>
                    </span>
                  ))
                }
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- THE RUN -->
    <section class="chapter">
      <div class="chapter__head">
        <h2 class="chapter__title">{process.heading}</h2>
        <p class="chapter__lede">{process.intro}</p>
      </div>

      <ol class="run">
        {
          process.steps.map((step, i) => (
            <li data-lamp={i}>
              <div class="volume">
                <span class="stamp stamp--n" aria-hidden="true">{i + 1}</span>
                <h3 class="run__t">{step.title}</h3>
                <p class="run__b">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- NOTES -->
    <section class="chapter">
      <div class="chapter__head">
        <h2 class="chapter__title">{credibility.heading}</h2>
        <p class="chapter__lede">{credibility.intro}</p>
      </div>

      <div class="notes">
        {
          credibility.items.map((item) => (
            <div class="note">
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CLOSE -->
    <section class="volume close">
      <h2 class="close__t">{ctas.home.heading} {ctas.home.accent}</h2>
      <p class="close__b">{ctas.home.body}</p>
      <div class="actions">
        <a class="btn" href={withBase('/contact/')}>{hero.primaryCta.label}</a>
        <a class="btn btn--paper" href={withBase('/services/')}>See the services</a>
      </div>
    </section>

    <footer class="foot">
      <span>{site.legalName}</span>
      <span>{site.location}</span>
      <span>Reply within one business day</span>
      {nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </footer>
  </div>
</AkariLayout>
