---
import BretonLayout from '../../layouts/BretonLayout.astro';
import Logo from '../../components/Logo.astro';
import Unit from '../../components/Unit.astro';
import { site, nav, hero, services, process, credibility, sections, ctas, meta } from '../../data/site.js';
import { withBase } from '../../utils/url.js';

const [leadBefore, leadAfter] = hero.headlineLead.split('an asset');

// Six plates in the book. Each unit keeps its plate number wherever it appears.
const specimen = [
  { variant: 'knot', plate: 'PL. I' },
  { variant: 'chevron', plate: 'PL. II' },
  { variant: 'lozenge', plate: 'PL. III' },
  { variant: 'spiral', plate: 'PL. IV' },
] as const;

const serviceUnits = [
  { variant: 'knot', plate: 'PL. I' },
  { variant: 'lozenge', plate: 'PL. III' },
  { variant: 'comb', plate: 'PL. V' },
] as const;

const stepUnits = ['chevron', 'spiral', 'cross', 'comb'] as const;
---

<BretonLayout title={meta.home.title} description={meta.home.description}>
  <div class="book">
    <header class="masthead">
      <a class="masthead__brand" href={withBase('/')}>
        <Logo class="masthead__mark" />
        <span class="masthead__name">{site.legalName}</span>
      </a>
      <nav aria-label="Main">
        {nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      </nav>
    </header>

    <!-- PLATE I -->
    <section class="plate" id="plate-1">
      <p class="plate__no">Plate I — the offer</p>

      <div class="title-plate">
        <div>
          <h1 class="title">{leadBefore}<em>an asset</em>{leadAfter} {hero.headlineAccent}</h1>
          <p class="sub">{hero.body}</p>
          <p class="assure">{hero.assurance}</p>

          <div class="actions">
            <a class="btn" href={withBase(hero.primaryCta.href)}>{hero.primaryCta.label}</a>
            <a class="btn btn--plain" href={withBase(hero.secondaryCta.href)}>{hero.secondaryCta.label}</a>
          </div>
        </div>

        <div class="specimen">
          {
            specimen.map((u, i) => (
              <Unit variant={u.variant} plate={u.plate} size={72} class={i % 2 ? 'unit--madder' : ''} />
            ))
          }
        </div>
      </div>
    </section>

    <div class="border-run" aria-hidden="true"></div>

    <dl class="ranged" style="margin-top:clamp(1.5rem,3vw,2.5rem)">
      {
        hero.facts.map((fact) => (
          <div>
            <dt>{fact.key}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <!-- PLATE II — the catalogue -->
    <section class="plate">
      <p class="plate__no">Plate II — the catalogue</p>
      <div class="plate__head">
        <h2 class="plate__title">{sections.homeServices.heading}</h2>
        <p class="plate__lede">{sections.homeServices.lede}</p>
      </div>

      <div class="catalogue">
        {
          services.map((service, i) => (
            <a class="entry" href={withBase(`/services/#${service.id}`)}>
              <Unit variant={serviceUnits[i].variant} plate={serviceUnits[i].plate} size={64} />
              <span>
                <span class="entry__name">{service.name}</span>
                <span class="entry__desc">{service.summary}</span>
              </span>
              <span class="entry__meta">
                {
                  service.meta.map((m) => (
                    <span>
                      {m.key}
                      <b>{m.value}</b>
                    </span>
                  ))
                }
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- PLATE III — the assembly -->
    <section class="plate">
      <p class="plate__no">Plate III — the assembly</p>
      <div class="plate__head">
        <h2 class="plate__title">{process.heading}</h2>
        <p class="plate__lede">{process.intro}</p>
      </div>

      <ol class="assembly">
        {
          process.steps.map((step, i) => (
            <li data-slot={i}>
              <Unit variant={stepUnits[i]} size={56} class="unit--madder" />
              <span class="assembly__n">Unit {String(i + 1).padStart(2, '0')}</span>
              <h3 class="assembly__t">{step.title}</h3>
              <p class="assembly__b">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- PLATE IV — the notes -->
    <section class="plate">
      <p class="plate__no">Plate IV — notes</p>
      <div class="plate__head">
        <h2 class="plate__title">{credibility.heading}</h2>
        <p class="plate__lede">{credibility.intro}</p>
      </div>

      <div class="footnotes">
        {
          credibility.items.map((item) => (
            <div class="footnote">
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- COLOPHON -->
    <section class="colophon">
      <h2 class="colophon__t">{ctas.home.heading} {ctas.home.accent}</h2>
      <p class="colophon__b">{ctas.home.body}</p>
      <div class="actions">
        <a class="btn" href={withBase('/contact/')}>{hero.primaryCta.label}</a>
        <a class="btn btn--plain" href={withBase('/services/')}>See the catalogue</a>
      </div>
    </section>

    <footer class="imprint">
      <span>{site.legalName}</span>
      <span>{site.location}</span>
      <span>Reply within one business day</span>
      {nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </footer>
  </div>
</BretonLayout>
