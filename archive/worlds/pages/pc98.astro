---
import Pc98Layout from '../../layouts/Pc98Layout.astro';
import Logo from '../../components/Logo.astro';
import { site, nav, hero, services, process, credibility, sections, ctas, meta } from '../../data/site.js';
import { withBase } from '../../utils/url.js';

const [leadBefore, leadAfter] = hero.headlineLead.split('an asset');
---

<Pc98Layout title={meta.home.title} description={meta.home.description}>
  <div class="crt">
    <header class="menu">
      <a class="menu__brand" href={withBase('/')}>{site.name}</a>
      <nav aria-label="Main">
        {nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      </nav>
    </header>

    <!-- THE FRAME -->
    <section class="frame sky" id="frame">
      <div class="frame__stage">
        <h1 class="title">{leadBefore}<em>an asset</em>{leadAfter} {hero.headlineAccent}</h1>
        <p class="sub">{hero.body}</p>
      </div>

      <div class="portrait dither" style="--from: var(--c02); --to: var(--c01)">
        <Logo class="portrait__mark" />
        <p class="portrait__cap">{site.tagline}</p>
      </div>
    </section>

    <!-- THE DOCKED TEXT WINDOW -->
    <div class="dock">
      <p class="dock__line">{hero.assurance}</p>
      <div class="actions">
        <a class="btn" href={withBase(hero.primaryCta.href)}>{hero.primaryCta.label}</a>
        <a class="btn btn--ghost" href={withBase(hero.secondaryCta.href)}>{hero.secondaryCta.label}</a>
      </div>
    </div>

    <dl class="status">
      {
        hero.facts.map((fact) => (
          <div>
            <dt>{fact.key}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <!-- SERVICES -->
    <section class="win">
      <p class="win__bar">
        <span>{sections.homeServices.label}</span>
        <span>3 entries</span>
      </p>
      <div class="win__body">
        <h2 class="heading">{sections.homeServices.heading}</h2>
        <p class="lede">{sections.homeServices.lede}</p>

        <div class="items">
          {
            services.map((service, i) => (
              <a class="item" href={withBase(`/services/#${service.id}`)}>
                <span class="item__n">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <span class="item__name">{service.name}</span>
                  <span class="item__desc">{service.summary}</span>
                </span>
                <span class="item__meta">
                  {
                    service.meta.map((m) => (
                      <span>
                        {m.key}
                        <b>{m.value}</b>
                      </span>
                    ))
                  }
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="win">
      <p class="win__bar">
        <span>{process.label}</span>
        <span>4 stages</span>
      </p>
      <div class="win__body">
        <h2 class="heading">{process.heading}</h2>
        <p class="lede">{process.intro}</p>

        <ol class="steps">
          {
            process.steps.map((step, i) => (
              <li class="step">
                <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step__t">{step.title}</h3>
                <p class="step__b">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- QUESTIONS -->
    <section class="win">
      <p class="win__bar">
        <span>{credibility.label}</span>
        <span>{credibility.items.length} entries</span>
      </p>
      <div class="win__body">
        <h2 class="heading">{credibility.heading}</h2>
        <p class="lede">{credibility.intro}</p>

        <div class="qs">
          {
            credibility.items.map((item) => (
              <div class="q">
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CLOSE -->
    <section class="close dither" style="--from: var(--c02); --to: var(--c01)">
      <h2 class="close__t">{ctas.home.heading} {ctas.home.accent}</h2>
      <p class="close__b">{ctas.home.body}</p>
      <div class="actions" style="margin-top:20px">
        <a class="btn" href={withBase('/contact/')}>{hero.primaryCta.label}</a>
        <a class="btn btn--ghost" href={withBase('/services/')}>See the services</a>
      </div>
    </section>

    <footer class="foot">
      <span>{site.legalName}</span>
      <span>{site.location}</span>
      <span>Reply within one business day</span>
      {nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </footer>
  </div>
</Pc98Layout>
