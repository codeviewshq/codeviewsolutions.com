---
/**
 * PC-98 SIXTEEN-COLOUR FIELD — screen shell. Self-contained; no global.css.
 */
// Latin subset only: the full family ships @font-face rules for every
// Japanese range, which is ~150 KB of CSS this page has no use for.
import '@fontsource/dotgothic16/latin-400.css';
import '../styles/world-pc98.css';

import { withBase } from '../utils/url.js';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000036" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <!--
      THESIS: The offer delivered on a sixteen-colour computer screen, where
      every tonal transition is a crosshatch of two palette entries. It refuses
      the category default — a gradient hero above three service cards —
      literally: this world has no gradients available to it at all.
      OWN-WORLD: A hard-limited sixteen-entry palette with the logo's navy as
      entry 1, declared once and never exceeded. Dither instead of blend, one
      2px unit that every size is an integer multiple of, double-bordered
      window panels, a portrait column holding the right of the frame, and a
      text window docked low. DotGothic16 throughout — a real dot-matrix
      gothic, not a pixel costume.
      STORY: A visitor reads the offer in a system with visibly finite means,
      which is itself the argument: constraints handled well.
      FIRST VIEWPORT: The frame. A three-band dithered sky, the title in
      pixel-shadowed caps on the left, the mark held full-height in a dithered
      portrait column on the right, and the free-review line in the docked
      window beneath with the action keys.
      FORM: PC-98 sixteen-colour field; dealt challenger
      digital-design-canon-pc98-sixteen-color-field, adopted at the user's
      request after being declined on audience fit; seed key 685831a9.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, DESIGN.md, and every shipping raster
      carrying its provenance.
    -->
    <a class="skip" href="#frame">Skip to content</a>
    <slot />
    <script>
      import { initBilling } from '../scripts/billing.js';
      initBilling();

      /* Palette rotation: the sky's crosshatch cycles through three adjacent
         palette entries, which is how this hardware animated anything. One
         property, stepped — never interpolated, because a 16-colour screen
         cannot interpolate. */
      const sky = document.querySelector<HTMLElement>('.sky');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (sky && !reduced) {
        const cycle = ['var(--c02)', 'var(--c03)', 'var(--c09)', 'var(--c02)', 'var(--c01)'];
        let i = 0;
        let timer = 0;
        const step = () => {
          i = (i + 1) % cycle.length;
          sky.style.setProperty('--from', cycle[i]);
        };
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting && !timer) timer = window.setInterval(step, 1400);
            else if (!e.isIntersecting && timer) {
              clearInterval(timer);
              timer = 0;
            }
          });
        });
        io.observe(sky);
      }
    </script>
  </body>
</html>
