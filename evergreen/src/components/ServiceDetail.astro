---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import ProjectCta from './ProjectCta.astro';
import { url } from '../utils/url.js';
const { service } = Astro.props;
---
<Layout title={`${service.name} — CodeView Solutions`} description={service.description}>
  <section class="inner-hero"><div class="wrap"><a class="back-link" href={url('/services/')}>All services</a><div class="inner-hero__grid"><div><h1>{service.headline}</h1><p class="lede">{service.intro}</p><a class="button" href={url(`/contact/?service=${service.slug}`)}>Discuss your project <Icon /></a></div><div class="service-sign" aria-hidden="true"><Icon name={service.icon} size={108} /><span>{service.name}</span></div></div></div></section>
  <section class="section"><div class="wrap section-split"><div><h2>What changes<br />for your business.</h2><p>Useful work starts with a useful outcome.</p></div><ul class="outcome-list">{service.outcomes.map(outcome => <li><Icon name="check" /><span>{outcome}</span></li>)}</ul></div></section>
  <section class="section section--tint"><div class="wrap section-split"><div><h2>What we can<br />help with.</h2><p>We agree the right scope around your actual need.</p></div><ul class="deliverable-list">{service.includes.map(item => <li>{item}<Icon size={20} /></li>)}</ul></div></section>
  <section class="section"><div class="wrap"><div class="section-heading"><h2>Where this becomes useful.</h2><p>Examples of the kinds of problems this service can address.</p></div><div class="use-cases">{service.examples.map(example => <article><h3>{example.title}</h3><p>{example.body}</p></article>)}</div></div></section>
  <section class="section section--tint"><div class="wrap section-split"><div><h2>A clear way<br />to move forward.</h2><p>Clarity before commitment. Useful progress after it.</p></div><ol class="step-list">{service.steps.map((step, i) => <li><span class="step-number">0{i + 1}</span><p>{step}</p></li>)}</ol></div></section>
  <ProjectCta title="Start with the problem in front of you." body="You do not need all the answers. Tell us where things are getting stuck." href={`/contact/?service=${service.slug}`} />
</Layout>
