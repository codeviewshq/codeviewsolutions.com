---
import { site } from '../data/site.js';
const { large = false } = Astro.props;
---
<span class:list={['brand', { 'brand--large': large }]}>
  {site.theme === 'signal' ? (
    <svg class="brand__mark" viewBox="0 0 100 56" fill="none" aria-hidden="true">
      <path d="M24 2H47L22 28l25 26H24L0 28 24 2Z" fill="currentColor" />
      <path d="M28 21h19l13 15 17-19h23L60 56 28 21Z" fill="var(--brand-accent)" />
    </svg>
  ) : (
    <svg class="brand__mark" viewBox="0 0 100 64" fill="none" aria-hidden="true">
      <path d="M49 17C42 3 24 0 12 8-7 19-2 50 15 57c16 8 30-2 37-13L41 29c-5 8-9 13-18 11-13-3-12-22 0-23 8-1 13 3 18 11l19 26c4 6 14 7 20-2l19-34H78L67 39 49 17Z" fill="currentColor" />
      <path d="M85 2h14c3 0 3 3 1 6l-4 7H76l6-10c1-2 2-3 3-3Z" fill="var(--brand-accent)" />
    </svg>
  )}
  <span class="brand__words"><span class="brand__name">CodeView</span><span class="brand__sub">Solutions</span></span>
</span>
