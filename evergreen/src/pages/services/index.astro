---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProjectCta from '../../components/ProjectCta.astro';
import { services } from '../../data/site.js';
import { url } from '../../utils/url.js';
---
<Layout title="Software Development, Consulting & AI Services — CodeView Solutions" description="Practical software development, technical consulting, and AI integration. Clear scope, useful outcomes, and ownership of your code.">
  <section class="inner-hero"><div class="wrap"><h1>The right help.<br />For the real problem.</h1><p class="lede">From a better application to a clearer technical decision, we help your business move forward with software that makes sense.</p><a class="button" href={url('/contact/')}>Discuss your project <Icon /></a></div></section>
  <section class="section"><div class="wrap service-rows">{services.map(service => <article class="service-row" id={service.slug}><div class="service-row__title"><Icon name={service.icon} size={36} /><h2>{service.name}</h2></div><div><p class="lede">{service.description}</p><ul class="compact-list">{service.includes.slice(0, 3).map(item => <li>{item}</li>)}</ul><a class="text-link" href={url(`/services/${service.slug}/`)}>Explore {service.name.toLowerCase()} <Icon size={20} /></a></div></article>)}</div></section>
  <section class="section section--tint"><div class="wrap section-split"><div><h2>A better website.<br />Looked after.</h2></div><div><p class="lede">We also modernize websites and look after them with predictable monthly care. Start with a free website review.</p><a class="text-link" href={url('/website-care/')}>Explore website care & plans <Icon size={20} /></a></div></div></section>
  <ProjectCta title="Not sure where to start?" body="Describe the problem in plain English. We’ll help you work out what kind of support makes sense." />
</Layout>
